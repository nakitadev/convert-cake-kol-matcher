# =======================================================
# Convert Cake — Thai TikTok KOL Matcher Configuration
# =======================================================

# Google Gemini API Key (Required for Brand DNA & Thai Campaign Hooks)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Apify API Token (Required for 100% Live TikTok Scraper)
# Get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Models
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# Service URLs (for Docker)
BACKEND_URL=http://backend:8000
