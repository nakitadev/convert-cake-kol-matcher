# =======================================================
# Convert Cake — Thai TikTok KOL Matcher Configuration
# =======================================================

# Google Gemini API Key (Required for Brand DNA & Thai Campaign Hooks)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Apify API Token (Required for 100% Live TikTok Scraper)
# Get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Jina Reader API (Optional: higher rate limits for web scraping at https://jina.ai)
# Free tier works out-of-the-box without key
JINA_API_KEY=

# Models
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# Langfuse Tracing (Optional: for LLM / LangGraph workflow observability)
# Get keys at https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Service URLs (for Docker)
BACKEND_URL=http://backend:8000
